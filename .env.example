# Copy this file as .env.local and fill it in with your Firebase web app config
# (Firebase Console → Project settings → Your apps → SDK setup and configuration → Config).
# Copiá este archivo como .env.local y completá con los datos de tu app web de Firebase
# (Firebase Console → Configuración del proyecto → Tus apps → SDK de Firebase → Config).
#
# These values are public by design: they ship inside the browser bundle. What protects your
# data is the Firestore/Storage security rules plus App Check — not keeping these secret.
# Estos valores son públicos por diseño: viajan dentro del bundle del navegador. Lo que protege
# tus datos son las reglas de Firestore/Storage y App Check, no mantenerlos en secreto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions region — must match setGlobalOptions in functions/src/index.ts.
# Región de las Cloud Functions — debe coincidir con setGlobalOptions en functions/src/index.ts.
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# App Check (optional, recommended): reCAPTCHA Enterprise site key. See README → App Check.
# App Check (opcional, recomendado): clave de sitio de reCAPTCHA Enterprise. Ver README → App Check.
VITE_RECAPTCHA_SITE_KEY=
