{
  "name": "dresscode",
  "version": "0.1.0",
  "description": "Your wardrobe and an AI stylist in one self-hostable, installable PWA. Built with React, Firebase and the Claude API.",
  "keywords": [
    "wardrobe",
    "ai-stylist",
    "outfit-generator",
    "pwa",
    "react",
    "firebase",
    "claude",
    "anthropic",
    "self-hosted"
  ],
  "homepage": "https://github.com/Pablo-Mdz/DressCode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pablo-Mdz/DressCode.git"
  },
  "bugs": {
    "url": "https://github.com/Pablo-Mdz/DressCode/issues"
  },
  "author": "Pablo Cigoy",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --project demo-dresscode --only firestore,storage \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
